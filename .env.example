# =============================================================================
# NavBox - 环境变量模板
#
# 用法:
#   1. 复制本文件: cp .env.example .env
#   2. 填写下方变量后启动
#   3. 敏感信息(尤其 ADMIN_PASSWORD)请勿提交到版本控制
#
# Docker 部署时, docker-compose.yml 内 environment 段已内置
# DATABASE_URL 等默认值; 若通过 .env 覆盖, compose 会自动读取本文件变量。
# =============================================================================

# -- 数据库 ---------------------------------------------------------------
# SQLite 数据源 URL。
#   本地开发:  file:./prisma/dev.db
#   Docker 部署: file:/app/data/navbox.db  (由 docker-compose 注入)
# DATABASE_URL="file:./prisma/dev.db"
DATABASE_URL="file:/app/data/navbox.db"

# -- 管理员账号 ------------------------------------------------------------
# 管理员初始密码(部署时必填, 容器启动时自动 seed 创建兜底账号)。
# 切勿写明文弱密码, 部署时通过环境变量或启动脚本传入。
ADMIN_PASSWORD=

# 管理员用户名(可选, 默认 admin)
ADMIN_USERNAME=admin

# -- 站点配置 --------------------------------------------------------------
# NAS 地址: 用于站点内显示链接的完整 URL(如 Docker scan 回填的完整地址)。
# 未配置时使用容器/本机默认地址。
# NAS_HOST=http://192.168.1.100

# -- 服务器 ----------------------------------------------------------------
# Next.js 监听端口(默认 3000)
# PORT=3000

# -- Docker 扫描 -----------------------------------------------------------
# Docker 组 GID(用于容器访问 Docker socket)。
# Linux: 运行 `getent group docker | cut -d: -f3` 获取 GID
# Windows/Mac: Docker Desktop 默认使用 999
DOCKER_GID=999
