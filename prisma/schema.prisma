// NavBox - NAS 导航站数据库 Schema
// Provider: SQLite
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 单管理员账号
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
}

// 链接分组
model Category {
  id         String   @id @default(cuid())
  name       String
  path       String   @unique @default("")
  icon       String?
  sortOrder  Int      @default(0)
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  links      Link[]

  @@index([path])
}

// 导航链接
model Link {
  id            String       @id @default(cuid())
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title         String
  url           String
  icon          String?
  description   String?
  sortOrder     Int          @default(0)
  isPrivate     Boolean      @default(false)
  clickCount    Int          @default(0)
  source        String       @default("MANUAL") // MANUAL | BOOKMARK_IMPORT | DOCKER_SCAN
  containerId   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
}

// 站点设置（key-value 存储）
model Setting {
  key    String @id @unique
  value  String
}

// 登录会话（服务端 Session）
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// 链接来源: 手动 / 书签导入 / Docker 扫描
// 因 Prisma 5.x + SQLite 不支持枚举, 在应用层用 @/types 的枚举约束。
// source 字段取值: MANUAL | BOOKMARK_IMPORT | DOCKER_SCAN
